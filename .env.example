# Upstream OpenAI-compatible API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional: require this bearer token for inbound requests.
# If empty, inbound Authorization is not checked by the router.
INBOUND_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000

# Request timeout in seconds
UPSTREAM_TIMEOUT=120
